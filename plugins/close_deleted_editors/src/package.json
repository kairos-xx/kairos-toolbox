{
  "name": "close-deleted-editors",
  "displayName": "Close Deleted Editors",
  "description": "Automatically closes editor tabs whose backing files were deleted.",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "closeDeletedEditors.close",
        "title": "Close Deleted Editors"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check core.js",
    "test": "node --test ../tests/*.test.js",
    "coverage": "node --test --experimental-test-coverage ../tests/*.test.js"
  }
}
